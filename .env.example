# .env.example — copie para .env e preencha com suas credenciais
# cp .env.example .env

# === Autenticação AdaLove (obrigatório) ===
LOGIN=seu.email@sou.inteli.edu.br
SENHA=sua_senha_aqui

# === Configurações opcionais ===
MAX_RETRIES=3
LOG_LEVEL=INFO
OUTPUT_DIR=dados_extraidos

# === Autenticação (opcional) ===
# Tempo para concluir o login manual + 2FA na janela do navegador (segundos).
# Aumente se precisar de mais tempo para aprovar a verificação no celular.
ADALOVE_AUTH_TIMEOUT=300

# Força modo headless: falha em vez de abrir janela se o login for necessário.
# Use apenas em CI/automação, após já ter uma sessão salva em .auth_profile/.
# ADALOVE_HEADLESS=true
